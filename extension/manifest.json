{
  "manifest_version": 3,
  "name": "Desk-Buddy Media Bridge",
  "version": "1.0",
  "description": "Sends what is playing (YouTube, YouTube Music, Spotify web, SoundCloud, Zing MP3...) to the local Desk-Buddy server and lets it control playback.",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://open.spotify.com/*",
        "*://soundcloud.com/*",
        "*://zingmp3.vn/*",
        "*://*.zingmp3.vn/*",
        "*://*.nhaccuatui.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
